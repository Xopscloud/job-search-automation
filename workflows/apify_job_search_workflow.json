            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Scraped Dataset Items": {
      "main": [
        [
          {
            "node": "Normalize Apify Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
