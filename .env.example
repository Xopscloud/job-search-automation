# ==============================================================================
# AUTOMATED JOB SEARCH & APPLICATION TRACKING SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS EC2 & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
# If using a custom domain or sub-domain pointing to your EC2 Elastic IP:
# Example: jobs.yourdomain.com
DOMAIN_NAME=localhost
SUBDOMAIN=n8n
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
# For production with SSL domain: set to https://jobs.yourdomain.com/
WEBHOOK_URL=http://localhost:5678/
SSL_EMAIL=your-email@example.com
GENERIC_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# 2. POSTGRES DATABASE FOR N8N (Internal)
# ------------------------------------------------------------------------------
POSTGRES_USER=n8n_admin
POSTGRES_PASSWORD=ChangeThisPasswordToAStrongSecretKey123!
POSTGRES_DB=n8n_jobs

# ------------------------------------------------------------------------------
# 3. JOB SEARCH PARAMETERS (Target criteria for automation)
# ------------------------------------------------------------------------------
# Search queries (comma-separated if multiple)
SEARCH_JOB_TITLES=Full Stack Developer, Python Developer, Backend Engineer, Software Engineer
# Target locations
SEARCH_LOCATIONS=Kochi, Trivandrum, Bangalore, Remote, India
# Experience filter (e.g., 2-5 years)
CANDIDATE_EXPERIENCE_YEARS=3
# Candidate skills to match against (used by AI ranking engine)
CANDIDATE_SKILLS=Python, FastAPI, Django, React, Node.js, PostgreSQL, Docker, AWS, Git, REST APIs
# Minimum match score (0-100) to trigger urgent notification alert
MIN_ALERT_MATCH_SCORE=80

# ------------------------------------------------------------------------------
# 4. AI SERVICE CREDENTIALS FOR RELEVANCE SCORING & RECRUITER EXTRACTION
# ------------------------------------------------------------------------------
# Choose one of the following AI providers:
# Option A: Groq (Recommended for FREE and ultra-fast Llama-3.3-70B model)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: OpenAI (gpt-4o-mini is low cost and highly accurate)
# Get key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Option C: Google Gemini (Gemini 1.5 Flash)
# Get key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Option D: Anthropic (claude-3-5-haiku)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATION CONFIGURATION (SMTP / Gmail)
# ------------------------------------------------------------------------------
# Sender email and SMTP settings (e.g. Gmail App Password or AWS SES)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM="Job Search Automation" <your_email@gmail.com>
EMAIL_TO=your_personal_inbox@gmail.com

# ------------------------------------------------------------------------------
# 6. INSTANT NOTIFICATIONS (Optional - Telegram, Discord, Slack)
# ------------------------------------------------------------------------------
# Telegram Bot for urgent high-match job alerts
# Create bot via @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord or Slack incoming webhook URL (optional)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 7. GOOGLE SHEETS INTEGRATION
# ------------------------------------------------------------------------------
# ID of your target Google Sheet (from URL: docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB_NAME=Active Jobs

# ------------------------------------------------------------------------------
# 8. APIFY INTEGRATION (Optional - For Cloud Scraper Actors)
# ------------------------------------------------------------------------------
# If using Apify for managed cloud LinkedIn/Indeed scrapers:
# Sign up and get token from: https://console.apify.com/account#/integrations
APIFY_API_TOKEN=apify_api_your_token_here
