# ==============================================================================
# JOB SEARCH AUTOMATION & SCRAPER MICROSERVICE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SCRAPER SERVICE & N8N INTEGRATION
# ------------------------------------------------------------------------------
PORT=8000
HOST=0.0.0.0
SHARED_NETWORK_NAME=n8n_net
# Full n8n Webhook URL (used by web-app to trigger job search workflow in n8n)
N8N_WEBHOOK_URL=https://n8n.johnsonthomas.co.in/webhook/your-webhook-id
# Full n8n Webhook URL for direct recruiter cold-outreach emails via Gmail
N8N_SEND_EMAIL_WEBHOOK_URL=https://n8n.johnsonthomas.co.in/webhook/send-recruiter-email

# ------------------------------------------------------------------------------
# 2. JOB SEARCH PARAMETERS (Target criteria for automation)
# ------------------------------------------------------------------------------
# Search queries (comma-separated if multiple)
SEARCH_JOB_TITLES=DevOps Engineer, Site Reliability Engineer (SRE), DevSecOps Engineer, Cloud Engineer, Solution Architect
# Target locations
SEARCH_LOCATIONS=Remote, Bangalore, Kochi, Trivandrum, India
# Experience filter (e.g., 2-5 years)
CANDIDATE_EXPERIENCE_YEARS=3
# Candidate skills to match against (used by AI ranking engine)
CANDIDATE_SKILLS=AWS, Azure, GCP, Kubernetes, Docker, Terraform, Ansible, CI/CD, Linux, Python, Bash, Helm, Prometheus, Grafana, DevSecOps
# Minimum match score (0-100) to trigger urgent notification alert
MIN_ALERT_MATCH_SCORE=80

# ------------------------------------------------------------------------------
# 3. AI SERVICE CREDENTIALS FOR RELEVANCE SCORING & RECRUITER EXTRACTION
# ------------------------------------------------------------------------------
# Option A: Groq (Recommended for FREE and ultra-fast Llama-3.3-70B model)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Option B: OpenAI (gpt-4o-mini is low cost and highly accurate)
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Option C: Google Gemini (Gemini 1.5 Flash)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Option D: Anthropic (claude-3-5-haiku)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. EMAIL NOTIFICATION CONFIGURATION (SMTP / Gmail)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
# For Gmail, generate an App Password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_char_app_password
EMAIL_FROM="Job Search Automation" <your_email@gmail.com>
EMAIL_TO=your_personal_inbox@gmail.com

# ------------------------------------------------------------------------------
# 5. INSTANT NOTIFICATIONS (Optional - Telegram, Discord, Slack)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. GOOGLE SHEETS INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_TAB_NAME=Active Jobs

# ------------------------------------------------------------------------------
# 7. APIFY INTEGRATION (Optional - For Cloud Scraper Actors)
# ------------------------------------------------------------------------------
APIFY_API_TOKEN=apify_api_your_token_here
